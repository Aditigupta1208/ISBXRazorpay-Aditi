# Copy to .env.local (never commit .env.local). Also add both in Vercel: Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
# Confirmed on the models page, 6 Oct 2026. Leave empty to use this default.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. Pin the USD to INR rate (for example on 12 Oct, so the video, the note and the demo agree). Leave empty for the live rate.
FX_RATE_INR_PER_USD=
# Optional anonymous usage counter (Upstash Redis REST, free tier via the Vercel Marketplace). Leave empty to turn it off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Needed to read the counts at /usage. Use a long random string. Never commit it.
USAGE_ADMIN_TOKEN=
